{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bionic-inventory",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bionic-inventory",
			"migrations_dir": "drizzle",
			"database_id": "305c793c-b1d9-4fd1-abe8-3e417162340b",
			"preview_database_id": "305c793c-b1d9-4fd1-abe8-3e417162340b"
		}
	],
	"vars": {
		"SLACK_WEBHOOK_URL": "https://hooks.slack.com/services/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"
	},	
	"workers_dev": true,
	"preview_urls": true
}
